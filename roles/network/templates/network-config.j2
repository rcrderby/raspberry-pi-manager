# {{ ansible_managed }}
network:
  version: 2
  renderer: NetworkManager
  ethernets:
    {{ network_interface }}:
      dhcp4: false
      addresses:
        - {{ network_address }}/{{ network_prefix }}
      routes:
        - to: default
          via: {{ network_gateway }}
{% if network_nameservers | length > 0 %}
      nameservers:
        addresses:
{% for nameserver in network_nameservers %}
          - {{ nameserver }}
{% endfor %}
{% endif %}
