---
extends: default

ignore: |
  .ansible/
  .cache/
  collections/
  **/vault*.yml
  **/vault*.yaml

# Settings required by ansible-lint
rules:
  braces:
    max-spaces-inside: 1
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  line-length:
    max: 160
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  truthy:
    allowed-values: ["true", "false"]
    check-keys: false
